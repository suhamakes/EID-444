#Demonstration of Amyloid Beta in a Spherical Solvent 

tolerance 2.0 #All atoms from different molecules will be at least 2.0 Angstroms apart!

filetype pdb #The output will be a PDB file.

output ABinSolventSpherical.pdb #Name of the output file.

structure AmyloidBetaModel.pdb
  number 1 
  fixed 0. 0. 0. 0. 0. 0. #The first three zeros correspond to the position of the center of mass and the last three correspond to the Euler angles of rotation, in radians.
  centerofmass #Fixed with its center of mass at center of the box.
end structure

# Water molecules will be put inside a sphere that contains the protein.
# There will be 16500 water molecules that will be put in a sphere
# centered in the origin, and a radius of 50. Angstroms.

structure water.pdb
  number 5000 
  inside sphere 0. 0. 0. 50.
end structure

